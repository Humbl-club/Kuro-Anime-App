// MARK: - Real Firebase Data Components
struct FeaturedCardReal: View {
    let media: any MediaDisplayable
    @State private var showDetail = false

    var body: some View {
        Button(action: {
            KuroAccessibility.impactHaptic(.light)
            showDetail = true
        }) {
            VStack(alignment: .leading, spacing: 0) {
                // Hero Image Container - Sharp edges, proper aspect ratio
                AsyncImage(url: URL(string: media.imageURL ?? "")) { image in
                    image
                        .resizable()
                        .scaledToFill()
                } placeholder: {
                    Rectangle()
                        .fill(
                            LinearGradient(
                                colors: [
                                    Color.black.opacity(0.03),
                                    Color.black.opacity(0.08)
                                ],
                                startPoint: .topLeading,
                                endPoint: .bottomTrailing
                            )
                        )
                        .overlay(
                            VStack(spacing: 8) {
                                ProgressView()
                                    .scaleEffect(0.7)
                                    .tint(.black.opacity(0.2))
                                Text("LOADING")
                                    .font(.system(size: 9, weight: .light))
                                    .tracking(2.0)
                                    .foregroundColor(.black.opacity(0.2))
                            }
                        )
                }
                .frame(maxWidth: .infinity)
                .frame(height: 420)
                .clipped()

                // Content Container - Refined spacing and typography
                VStack(alignment: .leading, spacing: 16) {
                    // Title - Elevated typography
                    Text(media.title.uppercased())
                        .font(.system(size: 22, weight: .ultraLight, design: .serif))
                        .tracking(1.0)
                        .foregroundColor(.black)
                        .lineLimit(2)
                        .fixedSize(horizontal: false, vertical: true)

                    // Metadata Row - Year, Type, Episodes
                    HStack(spacing: 6) {
                        Text(media.year)
                            .font(.system(size: 10, weight: .medium))
                            .tracking(1.2)
                            .foregroundColor(.black.opacity(0.5))

                        if let episodes = media.episodes {
                            Text("•")
                                .font(.system(size: 8))
                                .foregroundColor(.black.opacity(0.3))
                            Text("\(episodes) EPS")
                                .font(.system(size: 10, weight: .light))
                                .tracking(1.0)
                                .foregroundColor(.black.opacity(0.5))
                        } else if let chapters = media.chapters {
                            Text("•")
                                .font(.system(size: 8))
                                .foregroundColor(.black.opacity(0.3))
                            Text("\(chapters) CH")
                                .font(.system(size: 10, weight: .light))
                                .tracking(1.0)
                                .foregroundColor(.black.opacity(0.5))
                        }

                        if let rating = media.rating {
                            Text("•")
                                .font(.system(size: 8))
                                .foregroundColor(.black.opacity(0.3))
                            HStack(spacing: 3) {
                                Text("★")
                                    .font(.system(size: 9))
                                    .foregroundColor(.black.opacity(0.4))
                                Text(String(format: "%.1f", rating))
                                    .font(.system(size: 10, weight: .light))
                                    .tracking(0.5)
                                    .foregroundColor(.black.opacity(0.5))
                            }
                        }
                    }

                    // Description - Better line control and HTML cleanup
                    Text(cleanDescription)
                        .font(.system(size: 12, weight: .light))
                        .tracking(0.3)
                        .foregroundColor(.black.opacity(0.6))
                        .lineSpacing(5)
                        .lineLimit(4)
                        .multilineTextAlignment(.leading)
                }
                .padding(.horizontal, 20)
                .padding(.vertical, 24)
                .padding(.bottom, 8)
                .frame(maxWidth: .infinity, alignment: .leading)
            }
        }
        .buttonStyle(PlainButtonStyle())
        .sheet(isPresented: $showDetail) {
            if let anime = media as? Anime {
                AnimeDetailView(anime: anime)
            } else if let manga = media as? Manga {
                MangaDetailView(manga: manga)
            }
        }
    }

    // Clean HTML tags and extra spacing from description
    private var cleanDescription: String {
        var cleaned = media.displayDescription
        // Remove common HTML tags
        cleaned = cleaned.replacingOccurrences(of: "<br>", with: " ")
        cleaned = cleaned.replacingOccurrences(of: "<br/>", with: " ")
        cleaned = cleaned.replacingOccurrences(of: "<i>", with: "")
        cleaned = cleaned.replacingOccurrences(of: "</i>", with: "")
        cleaned = cleaned.replacingOccurrences(of: "<b>", with: "")
        cleaned = cleaned.replacingOccurrences(of: "</b>", with: "")
        // Remove excessive whitespace
        cleaned = cleaned.replacingOccurrences(of: "  ", with: " ")
        cleaned = cleaned.trimmingCharacters(in: .whitespacesAndNewlines)
        return cleaned
    }
}

