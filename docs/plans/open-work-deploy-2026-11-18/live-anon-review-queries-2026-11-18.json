{
  "Q10_club_peer": [
    {
      "d": "CREATE OR REPLACE FUNCTION public.club_peer_display_name(p_other uuid)\n RETURNS text\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'extensions'\nAS $function$\ndeclare\n  v_name text;\nbegin\n  if not public.shares_club_at_least(p_other, 'status') then\n    return null;\n  end if;\n  select nullif(trim(coalesce(p.display_name, '')), '') into v_name\n  from public.profiles p\n  where p.id = p_other;\n  return v_name;\nend;\n$function$\n"
    }
  ],
