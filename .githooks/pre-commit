#!/usr/bin/env bash
# Pre-commit hook: fast checks on staged files only.
# Runs: secrets scan + migration hygiene.
# Install: git config core.hooksPath .githooks
# Compatible with bash 3.2 (macOS default).
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"

echo "[pre-commit] Running fast quality checks..."

# ── 1) Secrets check on staged files only ─────────────────────────────────────
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [[ -z "$STAGED_FILES" ]]; then
  echo "[pre-commit] No staged files. Skipping."
  exit 0
fi

FOUND=0

# Whitelist paths
WHITELIST_RE="(test-fixtures|test_fixtures|example|\.example|mock|node_modules|router_test_cases\.js|\.checksums)"

# Secret patterns (flat arrays for bash 3.2 compat)
PATTERN_NAMES=("JWT_TOKEN" "SUPABASE_KEY" "OPENAI_SK" "GROQ_KEY")
PATTERN_REGEXES=(
  'eyJhbGci[0-9A-Za-z._-]{20,}'
  'sbp_[0-9a-zA-Z]{20,}'
  'sk-[0-9a-zA-Z]{20,}'
  'gsk_[0-9a-zA-Z]{20,}'
)

# Safe context patterns
SAFE_RE='(process\.env|Deno\.env|getenv|Info\.plist|Environment\.|SUPABASE_SERVICE_ROLE_KEY)'

while IFS= read -r file; do
  # Only check Swift, TypeScript, JavaScript files
  case "$file" in
    *.swift|*.ts|*.js) ;;
    *) continue ;;
  esac

  # Skip whitelisted paths
  if echo "$file" | grep -qE "$WHITELIST_RE"; then
    continue
  fi

  FULL_PATH="$ROOT_DIR/$file"
  if [[ ! -f "$FULL_PATH" ]]; then
    continue
  fi

  i=0
  while [[ $i -lt ${#PATTERN_NAMES[@]} ]]; do
    pattern_name="${PATTERN_NAMES[$i]}"
    pattern="${PATTERN_REGEXES[$i]}"
    i=$((i + 1))

    MATCHES=$(git diff --cached -U0 -- "$file" 2>/dev/null | grep -E '^\+' | grep -v '^\+\+\+' | grep -E "$pattern" || true)
    if [[ -n "$MATCHES" ]]; then
      while IFS= read -r match_line; do
        # Skip safe contexts
        if echo "$match_line" | grep -qE "$SAFE_RE"; then
          continue
        fi
        # Skip comments
        if echo "$match_line" | grep -qE '^\+\s*(//|/\*|\*)'; then
          continue
        fi
        echo "[pre-commit] FAIL: [$pattern_name] in $file"
        echo "  $match_line"
        FOUND=$((FOUND + 1))
      done <<< "$MATCHES"
    fi
  done
done <<< "$STAGED_FILES"

if [[ $FOUND -gt 0 ]]; then
  echo ""
  echo "[pre-commit] BLOCKED: $FOUND potential secret(s) in staged files."
  echo "Remove hardcoded secrets before committing."
  exit 1
fi

# ── 2) Migration hygiene on staged SQL files ──────────────────────────────────
STAGED_SQL=$(echo "$STAGED_FILES" | grep "^supabase/migrations/.*\.sql$" || true)

if [[ -n "$STAGED_SQL" ]]; then
  echo "[pre-commit] Checking migration hygiene for staged SQL files..."

  while IFS= read -r sql_file; do
    BASENAME=$(basename "$sql_file")
    if ! echo "$BASENAME" | grep -qE '^[0-9]{14}'; then
      if ! echo "$BASENAME" | grep -qE '^[0-9]{8}'; then
        echo "[pre-commit] WARNING: $BASENAME has non-standard migration name prefix"
      fi
    fi
  done <<< "$STAGED_SQL"
fi

echo "[pre-commit] All fast checks passed."
exit 0
